# Copy to experiments/config.env and adjust paths.
# shellcheck disable=SC2034

# Repository root (auto-detected by common.sh if unset)
# REPO_ROOT=/path/to/xseal

# CMake build directory containing the `xseal_bench` target
BUILD_DIR=build

# hg38 FASTA (leave empty: common.sh defaults to $REPO_ROOT/data/hg38.fa after REPO_ROOT is set)
HG38_FASTA=
# Set to 1 to copy HG38_FASTA to /dev/shm/hg38.fa and use that path for e2e
USE_SHM=${USE_SHM:-1}

# End-to-end xseal_bench worker threads (default: logical CPUs minus 1 for producer headroom)
XSEAL_E2E_THREADS=${XSEAL_E2E_THREADS:-}

# Comma-separated thread counts for pure scanner micro-benchmark
PURE_SCAN_THREADS_LIST=${PURE_SCAN_THREADS_LIST:-1,6,12}

WARMUP=${WARMUP:-3}
TRIALS=${TRIALS:-10}

# Optional: run one e2e pass with --profile (writes parse/getNext breakdown)
E2E_PROFILE_ONCE=${E2E_PROFILE_ONCE:-1}

# If 1, warn when cpufreq governor is not performance (does not change system)
GOVERNOR_CHECK=${GOVERNOR_CHECK:-0}

# --- Vendor / optional experiments (see README + vendor_versions.env) ---
FETCH_VENDOR=${FETCH_VENDOR:-1}
USE_HYPERFINE=${USE_HYPERFINE:-0}
# Modular Rust baseline (simd-minimizers): 1 = run rust_sota_bench (needs rustc/cargo)
RUN_RUST_SOTA=${RUN_RUST_SOTA:-1}
# Thread count for rust_sota_bench -t (e.g. 12 to align with paper integration caption)
RUST_SOTA_THREADS=${RUST_SOTA_THREADS:-12}
RUN_MINIMAP2_E2E=${RUN_MINIMAP2_E2E:-1}
# Part IV: build integration/minimap2_xseal_hardened and run segmented index repro (stderr RESULT lines)
RUN_MINIMAP2_XSEAL_E2E=${RUN_MINIMAP2_XSEAL_E2E:-1}
# Optional override for built binary (default: $REPO_ROOT/integration/minimap2_xseal_hardened/minimap2_xseal)
# MINIMAP2_XSEAL_BIN=
# MINIMAP2_XSEAL_INDEX_OUT=/tmp/hg38_xseal_repro.mmi
PART2_PMU=${PART2_PMU:-0}
PART1_PERF=${PART1_PERF:-0}
# Part I rigorous 2-bit benches (slow on full hg38); set 0 for a faster smoke run
RUN_PART1=${RUN_PART1:-1}
PART1_THREADS_LIST=${PART1_THREADS_LIST:-1,12}
# Pre-packed 2-bit hg38 for Part I rigorous benches (auto-built from HG38_FASTA if missing)
TWO_BIT_HG38=${TWO_BIT_HG38:-}

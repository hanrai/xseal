# Pinned third-party sources for experiments fetch script (bash: set -a; source this file; set +a)
# Override in experiments/config.env if you need a different ref.
#
# Rust baseline: simd-minimizers (path dependency for rigorous_bench/simd_min_bench + external/rust_sota_bench)
SIMD_MINIMIZERS_REPO_URL="${SIMD_MINIMIZERS_REPO_URL:-https://github.com/rust-seq/simd-minimizers.git}"
SIMD_MINIMIZERS_GIT_REF="${SIMD_MINIMIZERS_GIT_REF:-v2.3.1}"

# Optional Part IV: minimap2 upstream (only used when running minimap2 index script)
MINIMAP2_REPO_URL="${MINIMAP2_REPO_URL:-https://github.com/lh3/minimap2.git}"
MINIMAP2_GIT_REF="${MINIMAP2_GIT_REF:-v2.28}"

# Optional: verify tarball/git checkout (leave empty to skip)
SIMD_MINIMIZERS_SHA256="${SIMD_MINIMIZERS_SHA256:-}"
